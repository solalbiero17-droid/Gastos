# Firebase project config (Project settings → General → Your apps → SDK setup and configuration).
# These are public client identifiers, safe to ship in the app bundle — lock down access with
# Firestore security rules (see firestore.rules) and Firebase Auth's authorized domains instead.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud Console → APIs & Services → Credentials).
# Create one OAuth client per platform you ship; leave unused ones blank.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
